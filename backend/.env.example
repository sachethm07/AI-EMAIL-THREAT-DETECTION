# Required
JWT_SECRET=replace-with-at-least-32-random-characters
MONGO_URI=mongodb://mongo:27017
MONGO_DB=sentinmail
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
CORS_ORIGINS=http://localhost:5173
# Optional intelligence sources
GEOIP_DB_PATH=data/GeoLite2-City.mmdb
GEOIP_API_URL=https://ipapi.co/{ip}/json/
ABUSEIPDB_KEY=
# Optional alert e-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
# Optional IMAP ingestion of an AUTHORIZED mailbox
IMAP_ENABLED=false
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=120
